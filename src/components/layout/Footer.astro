---
// i18n
import { useTranslations } from "../../i18n/utils";

// 1. Obtiene el idioma actual y el año
const currentLang: 'es' | 'en' = (Astro.currentLocale === 'en' ? 'en' : 'es');
const t = useTranslations(currentLang);
const year = new Date().getFullYear();
---

<footer
    class="bg-muted text-foreground rounded-t-2xl mt-auto transition-colors duration-400 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1),0_-2px_4px_-1px_rgba(0,0,0,0.06)]"
>
    <div
        class="w-full max-w-7xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4"
    >
        <!-- Sección de información -->
        <nav
            class="order-1 md:order-1 w-full md:w-auto flex justify-center md:justify-start"
        >
            <a
                href={currentLang === "en" ? "/en/about" : "/about"}
                class="inline-block px-4 py-2 rounded-lg bg-foreground/5 hover:bg-foreground/10 transition-colors text-lg font-bold"
            >
                {t("footer.whatis")}
                <span>→</span>
            </a>
        </nav>

        <aside
            class="order-2 md:order-2 flex flex-col items-center w-full md:w-auto text-center"
        >
            <!-- Bloque unificado: Logo | Divisor | Slogans -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
                <!-- Izquierda: Logo y nombre de la app -->
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">🍅</span>
                    <span class="font-bold text-xl tracking-tight text-foreground dark:text-white">Tempo</span>
                </div>

                <!-- Línea divisoria (vertical en desktop, horizontal en móvil) -->
                <div class="hidden sm:block w-px h-10 bg-border"></div>
                <div class="sm:hidden w-12 h-px bg-border"></div>

                <!-- Derecha: Slogans -->
                <div class="text-xs sm:text-sm font-medium text-muted-foreground space-y-0.5 text-center sm:text-left">
                    <p>{t("footer.slogan.1")}</p>
                    <p>{t("footer.slogan.2")}</p>
                    <p>{t("footer.slogan.3")}</p>
                </div>
            </div>

            <!-- Bloque inferior: Desarrollador, Tecnologías y Copyright con espaciado equilibrado -->
            <div class="pt-4 flex flex-col items-center gap-3">
                <p class="text-xs text-muted-foreground">
                    {t("footer.developed")}
                    <span class="font-bold text-foreground">sinx</span>
                </p>

                <!-- Tecnologías usadas -->
                <div class="flex flex-wrap justify-center gap-1.5">
                    <span class="inline-flex h-5 items-center rounded-full border border-border px-2 text-[10px] font-medium text-muted-foreground"
                        >Astro</span
                    >
                    <span class="inline-flex h-5 items-center rounded-full border border-border px-2 text-[10px] font-medium text-muted-foreground"
                        >React</span
                    >
                    <span class="inline-flex h-5 items-center rounded-full border border-border px-2 text-[10px] font-medium text-muted-foreground"
                        >Tailwind</span
                    >
                    <span class="inline-flex h-5 items-center rounded-full border border-border px-2 text-[10px] font-medium text-muted-foreground"
                        >Bun</span
                    >
                    <span class="inline-flex h-5 items-center rounded-full border border-border px-2 text-[10px] font-medium text-muted-foreground"
                        >Cloudflare</span
                    >
                </div>

                <!-- Copyright -->
                <p class="text-xs text-muted-foreground">
                    Copyright © {year} - {t("footer.rights")}
                </p>
            </div>
        </aside>
    </div>
</footer>
