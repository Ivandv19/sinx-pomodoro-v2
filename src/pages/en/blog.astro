---
// Layout
import Layout from "../../layouts/Layout.astro";
// i18n
import { useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "en") as "es" | "en";
const t = useTranslations(lang);
---

<Layout title={t("blog.title")} lang="en" description={t("blog.description")}>
    <div class="max-w-4xl mx-auto py-20 text-center space-y-8">
        <h1
            class="text-5xl font-extrabold bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent py-4"
        >
            {t("blog.title")}
        </h1>
        <p class="text-2xl text-muted-foreground">{t("blog.comingSoon")}</p>
        <div class="rounded-2xl bg-card shadow-xl ring-1 ring-border max-w-lg mx-auto">
            <div class="p-8 flex flex-col gap-4">
                <p class="text-lg">
                    {t("blog.body")}
                </p>
                <div class="mt-4">
                    <a href="/en" class="inline-flex h-8 items-center justify-center rounded-lg bg-primary px-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/80 transition-all">{t("blog.back")}</a>
                </div>
            </div>
        </div>
    </div>
</Layout>
