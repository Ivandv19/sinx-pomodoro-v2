---
// Layout
import Layout from "../layouts/Layout.astro";
// i18n
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "es") as "es" | "en";
const t = useTranslations(lang);
---

<Layout title={t("404.title")}>
  <div
    class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6 animate-fade-in"
  >
    <div
      class="text-9xl font-black bg-gradient-to-b from-foreground/20 to-transparent bg-clip-text text-transparent select-none"
    >
      404
    </div>
    <h1 class="text-3xl font-bold">{t("404.heading")}</h1>
    <p class="text-xl text-muted-foreground max-w-md">
      {t("404.description")}
    </p>
    <a
      href="/"
      class="inline-flex h-9 items-center justify-center rounded-full bg-primary px-8 text-sm font-medium text-primary-foreground shadow-lg hover:scale-105 hover:bg-primary/80 transition-all"
    >
      {t("404.back")}
    </a>
  </div>
</Layout>
