{
	"name": "tempo",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev:full": "astro build && wrangler pages dev dist/ --compatibility-date=2026-04-30 --ip localhost --port 4321",
		"prebuild": "bun install",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"sync:db": "wrangler d1 export pomodoro-db --remote --output=.wrangler/pomodoro-db.sql && wrangler d1 execute pomodoro-db --local --file=.wrangler/pomodoro-db.sql",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"gen:secret": "bun -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
	},
	"overrides": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.1",
		"@astrojs/react": "^6.0.2",
		"@astrojs/sitemap": "^3.7.3",
		"@base-ui/react": "^1.7.0",
		"@better-auth/drizzle-adapter": "^1.6.27",
		"@fontsource/outfit": "^5.3.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.5.3",
		"@iconify-json/lucide": "^1.2.123",
		"@iconify/react": "^6.0.2",
		"@marsidev/react-turnstile": "^1.6.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.1",
		"better-auth": "1.6.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "4.13.2",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"resend": "^6.19.0",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/workers-types": "^5.20260813.1",
		"typescript": "~5.9"
	}
}
