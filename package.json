{
	"name": "tempo",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev:full": "astro build && wrangler pages dev dist/ --compatibility-date=2026-04-30 --ip localhost --port 4321",
		"prebuild": "bun install",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"sync:db": "wrangler d1 export pomodoro-db --remote --output=.wrangler/pomodoro-db.sql && wrangler d1 execute pomodoro-db --local --file=.wrangler/pomodoro-db.sql",
		"db:gen": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:pull": "drizzle-kit pull --config=drizzle.pull.config.ts",
		"db:apply:local": "wrangler d1 execute pomodoro-db --local --file=",
		"db:apply:remote": "wrangler d1 execute pomodoro-db --remote --file=",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"seed:e2e": "bun tests/e2e/seed.ts",
		"test:e2e": "bun run seed:e2e && playwright test",
		"test:smoke": "bun run build && playwright test --config=playwright.smoke.config.ts",
		"test:unit": "vitest run",
		"gen:secret": "bun -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
	},
	"overrides": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.0",
		"@astrojs/react": "^6.0.5",
		"@astrojs/sitemap": "^3.7.4",
		"@base-ui/react": "^1.8.0",
		"@better-auth/drizzle-adapter": "1.6.27",
		"@fontsource/outfit": "^5.3.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.3",
		"@iconify-json/lucide": "^1.2.129",
		"@iconify/react": "^6.0.2",
		"@marsidev/react-turnstile": "^1.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.1",
		"better-auth": "1.6.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"resend": "^6.26.0",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "^2.5.12",
		"@cloudflare/workers-types": "^5.20260904.1",
		"@playwright/test": "^1.62.1",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.129.0"
	}
}
