# Authentication (Better Auth)
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=your_super_secret_key_here

# Cloudflare Turnstile (Captcha)
PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Hashing service
HASH_SERVICE_URL=http://localhost:3001
HASH_SERVICE_API_KEY=dev_key

# Resend (Emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM=Tempo <noreply@tempo.mgdc.site>

# Cloudflare (drizzle-kit pull / studio remoto)
# Crea un API Token con permiso D1 -> Edit en https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id
CLOUDFLARE_API_TOKEN=your_api_token
